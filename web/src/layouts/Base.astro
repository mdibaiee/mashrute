---
import SuggestButton from '../components/SuggestButton.astro';
import SuggestDialog from '../components/SuggestDialog.astro';

const { title, subtitle, wide = false,
        // What a suggestion from this page is about. Detail pages pass their
        // own record so the issue names it instead of just the URL.
        suggestKind = 'page', suggestId = '', suggestLabel = '',
        suggestLabelFa = '' } = Astro.props;
// A page may supply its bilingual heading through the slots instead of the
// string props; the props are still what the <title> tag uses.
const hasSub = subtitle || Astro.slots.has('subtitle');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: `${base}/`, en: 'Chronology', fa: 'گاه‌شمار' },
  { href: `${base}/people/`, en: 'People', fa: 'اشخاص' },
  { href: `${base}/groups/`, en: 'Groups', fa: 'گروه‌ها' },
  { href: `${base}/notes/`, en: 'Notes', fa: 'یادداشت‌ها' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="fa" data-lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — The Iranian Constitutional Revolution</title>
    <meta name="description" content="A bilingual database of the Iranian Constitutional Revolution, 1906–1911." />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
    <!-- Umami: cookieless page views, no personal data, so no consent banner. -->
    <script is:inline defer src="https://cloud.umami.is/script.js"
            data-website-id="8ef07471-780d-4e99-ade6-9ecc7baa7567"></script>
    <script is:inline>
      // Set language before first paint so there is no flash of the wrong script.
      (function () {
        var l = localStorage.getItem('mashruteh-lang') || 'fa';
        var h = document.documentElement;
        h.setAttribute('data-lang', l);
        h.setAttribute('lang', l === 'fa' ? 'fa' : 'en');
        if (l === 'fa') h.setAttribute('dir', 'rtl'); else h.removeAttribute('dir');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class={wide ? 'shell shell--wide' : 'shell'}>
        <a class="brand" href={`${base}/`}>
          <span class="brand__mark" aria-hidden="true"></span>
          <span class="brand__text">
            <span class="en">Mashruteh</span><span class="fa">مشروطه</span>
          </span>
        </a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class:list={['navlink', {
              // The chronology lives at the root, which every path starts with,
              // so it has to match exactly rather than by prefix.
              on: n.href === `${base}/` ? path === n.href : path.startsWith(n.href),
            }]}>
              <span class="en">{n.en}</span><span class="fa">{n.fa}</span>
            </a>
          ))}
        </nav>
        <button id="langToggle" class="lang" type="button" aria-label="Switch language">
          <span class="en" lang="fa">فارسی</span><span class="fa" lang="en">English</span>
        </button>
      </div>
    </header>

    {title && (
      <div class="pagehead">
        <div class={wide ? 'shell shell--wide' : 'shell'}>
          <h1><slot name="title">{title}</slot></h1>
          {hasSub && <p class="sub"><slot name="subtitle">{subtitle}</slot></p>}
          <slot name="head-extra" />
        </div>
      </div>
    )}

    <main id="main" class={wide ? 'shell shell--wide' : 'shell'}>
      <slot />
    </main>

    <footer class="site">
      <div class={wide ? 'shell shell--wide' : 'shell'}>
        <p>
          <span class="en">Data extracted from Janet Afary, <em>The Iranian Constitutional Revolution, 1906–1911</em> (Columbia University Press, 1996) and its Persian translation by Reza Rezaei (نشر بیستون, ۱۳۸۵).</span>
          <span class="fa">داده‌ها برگرفته از ژانت آفاری، <em>انقلاب مشروطهٔ ایران ۱۹۰۶–۱۹۱۱</em> (انتشارات دانشگاه کلمبیا، ۱۹۹۶) و ترجمهٔ فارسی رضا رضایی (نشر بیستون، ۱۳۸۵).</span>
        </p>
        <p class="fine">
          <span class="en">Gregorian dates are the anchor; Solar Hijri dates are computed astronomically, not copied from the translation. <a href={`${base}/notes/`}>Notes on the sources and the dates →</a></span>
          <span class="fa">تاریخ میلادی مبناست؛ تاریخ هجری شمسی به‌روش نجومی محاسبه شده و از ترجمه نقل نشده است. <a href={`${base}/notes/`}>← یادداشت‌ها دربارهٔ منابع و تاریخ‌ها</a></span>
        </p>
        <p class="foot-suggest">
          <SuggestButton kind={suggestKind} id={suggestId} label={suggestLabel} labelFa={suggestLabelFa} />
        </p>
      </div>
    </footer>

    <SuggestDialog />

    <script is:inline>
      document.getElementById('langToggle')?.addEventListener('click', function () {
        var h = document.documentElement;
        var next = h.getAttribute('data-lang') === 'fa' ? 'en' : 'fa';
        h.setAttribute('data-lang', next);
        h.setAttribute('lang', next);
        if (next === 'fa') h.setAttribute('dir', 'rtl'); else h.removeAttribute('dir');
        localStorage.setItem('mashruteh-lang', next);
        document.dispatchEvent(new CustomEvent('langchange', { detail: next }));
      });
    </script>

    <style is:global>
      /* The palette is the one Persian tilework has used since the Timurids:
         fīrūza turquoise and lāzhvard lapis as the structural pair, with rose
         and garden-green as the two accents that carry the figurative work. */
      :root {
        --lapis: #263991;
        --turquoise: #3fc9db;
        --rose: #d2588b;
        --green: #1cb680;

        --ink: #14183a;
        --ink-2: #454b73;
        --ink-3: #7b81a3;
        --paper: #ffffff;
        --paper-2: #fbfcfe;
        --line: #d5daea;
        --line-2: #e7eaf5;
        --accent: var(--lapis);
        --accent-2: #3a51bd;
        --gold: var(--rose);
        --radius: 10px;
        --shadow: 0 1px 2px rgba(38,57,145,.05), 0 6px 20px rgba(38,57,145,.07);
        --fs-en: 'Open Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        --fs-fa: 'Gandom', 'Vazirmatn', 'IRANSans', 'Segoe UI', Tahoma, sans-serif;
        --fs-ui: 'Open Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
      }
      /* In Persian, Gandom carries the whole page — not just body copy. The UI
         and display stacks are redefined here rather than per rule, so nav
         links, tags, buttons and numerals all pick it up. Gandom ships Latin
         glyphs, so the occasional Latin run stays in the same voice. */
      html[data-lang='fa'] {
        --fs-ui: 'Gandom', ui-sans-serif, system-ui, 'Segoe UI', Tahoma, sans-serif;
        --fs-en: 'Gandom', ui-serif, Georgia, serif;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--paper); color: var(--ink);
        font-family: var(--fs-en); font-size: 17px; line-height: 1.6;
      }
      html[data-lang='fa'] body { font-family: var(--fs-fa); line-height: 1.85; }
      html[data-lang='en'] .fa, html[data-lang='fa'] .en { display: none !important; }
      html[data-lang='fa'] .en-only { display: none !important; }

      .shell { max-width: 62rem; margin: 0 auto; padding: 0 1.25rem; }
      .shell--wide { max-width: 78rem; }
      a { color: inherit; }
      .skip { position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip-path: inset(50%); white-space: nowrap; }
      .skip:focus { position: fixed; width: auto; height: auto; clip-path: none;
        inset-inline-start: 1rem; top: .5rem; background: var(--paper-2);
        padding: .5rem 1rem; border-radius: 8px; z-index: 99; }

      header.site { border-bottom: 1px solid var(--line); background: var(--paper-2); position: sticky; top: 0; z-index: 20; backdrop-filter: saturate(1.4) blur(6px); }
      header.site .shell { display: flex; align-items: center; gap: 1.25rem; height: 60px; }
      .brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; font-weight: 600; }
      /* The eight-pointed star — setāre-ye hasht-par — is the unit cell of
         Persian tilework: two squares, one rotated 45°. */
      .brand__mark { position: relative; width: 20px; height: 20px; flex: none; }
      .brand__mark::before, .brand__mark::after {
        content: ''; position: absolute; inset: 0; border-radius: 2px;
        background: linear-gradient(135deg, var(--turquoise), var(--lapis));
      }
      .brand__mark::after { transform: rotate(45deg); }
      .brand__text { font-size: 1.05rem; line-height: 1.1; }
      header nav { display: flex; gap: .25rem; margin-inline-start: auto; }
      .navlink { white-space: nowrap; font-family: var(--fs-ui); font-size: .88rem; text-decoration: none; padding: .4rem .7rem; border-radius: 99px; color: var(--ink-2); }
      .navlink:hover { background: var(--line-2); color: var(--ink); }
      .navlink.on { background: var(--accent); color: #fff; }
      .lang { font-family: var(--fs-ui); font-size: .8rem; border: 1px solid var(--line); background: transparent; color: var(--ink-2); padding: .35rem .7rem; border-radius: 99px; cursor: pointer; }
      .lang:hover { border-color: var(--accent); color: var(--accent); }
      .lang [lang='fa'] { font-family: var(--fs-fa); }
      .lang [lang='en'] { font-family: 'Open Sans', ui-sans-serif, system-ui, sans-serif; }

      /* A tile band under the masthead: the four palette colours repeating the
         way a border course (hāshiyeh) runs along the top of a tiled wall. */
      header.site::after {
        content: ''; display: block; height: 3px;
        background: repeating-linear-gradient(90deg,
          var(--lapis) 0 26px, var(--turquoise) 26px 52px,
          var(--green) 52px 78px, var(--rose) 78px 104px);
        opacity: .9;
      }

      .pagehead { padding: 2.5rem 0 1.25rem; border-bottom: 1px solid var(--line-2); }
      .pagehead h1 { margin: 0; font-size: clamp(1.7rem, 3.6vw, 2.5rem); line-height: 1.15; letter-spacing: -.01em; }
      .pagehead .sub { margin: .6rem 0 0; color: var(--ink-2); max-width: 46rem; }
      main { padding: 2rem 0 4rem; }
      footer.site { border-top: 1px solid var(--line); padding: 2rem 0 3rem; color: var(--ink-3); font-size: .84rem; }
      footer.site p { margin: 0 0 .6rem; max-width: 52rem; }
      footer.site .fine { font-size: .78rem; }
      footer.site a { color: var(--lapis); font-weight: 500; }

      .muted { color: var(--ink-3); }
      .tag { display: inline-block; font-family: var(--fs-ui); font-size: .7rem; letter-spacing: .04em; text-transform: uppercase; padding: .2rem .5rem; border-radius: 99px; background: var(--line-2); color: var(--ink-2); }
      .tag--accent { background: color-mix(in srgb, var(--turquoise) 20%, transparent); color: #14607a; }
      .foot-suggest { margin-top: 1.1rem; }

      /* On a phone the masthead cannot hold the brand, four nav links and the
         language toggle on one line, so the nav drops to its own row and
         scrolls sideways within itself rather than widening the page. */
      @media (max-width: 46rem) {
        /* Wrapped over two rows the masthead is tall enough that pinning it
           would eat a real share of a phone screen, so it scrolls away. */
        header.site { position: static; }
        header.site .shell {
          height: auto; flex-wrap: wrap; row-gap: .35rem;
          column-gap: .75rem; padding-block: .55rem;
        }
        .brand { order: 1; }
        .lang { order: 2; margin-inline-start: auto; }
        header nav {
          order: 3; width: 100%; margin-inline-start: 0;
          overflow-x: auto; scrollbar-width: none; padding-bottom: 2px;
        }
        header nav::-webkit-scrollbar { display: none; }
        .navlink { flex: none; font-size: .84rem; padding: .35rem .6rem; }
        .pagehead { padding: 1.6rem 0 1rem; }
      }
    </style>
  </body>
</html>
