---
import { paletteOf, initials, initialsFa } from '../lib/util.js';
import portraits from '../data/portraits.json';

// We have no photographs of these people, so rather than invent likenesses we
// draw a deterministic monogram: initials over a colour derived from the id, so
// a given person always looks the same everywhere on the site.
const { id, nameEn, nameFa, size = 40, link = true, ring = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [c1, c2] = paletteOf(id);
const mono = initials(nameEn || id);
const monoFa = initialsFa(nameFa) || mono;
const style = `--c1:${c1}; --c2:${c2}; --sz:${size}px;`;
// A real photograph where one could be found and verified; the monogram is the
// fallback, not a placeholder waiting to be replaced.
const shot = portraits[id];
const Tag = link ? 'a' : 'span';
const attrs = link ? { href: `${base}/people/${id}/` } : {};
---
<Tag class="av" style={style} {...attrs} data-name-en={nameEn} data-name-fa={nameFa}>
  <span class="av__disc" class:list={[{ 'av__disc--ring': ring }]} aria-hidden="true">
    {shot
      ? <img class="av__img" src={`${base}${shot.src}`} loading="lazy" decoding="async"
             width={size} height={size}
             alt={nameEn ? `Portrait of ${nameEn}` : ''} />
      : <span class="av__mono"><span class="en">{mono}</span><span class="fa">{monoFa}</span></span>}
  </span>
  {!shot && (
    <span class="av__sr"><span class="en">{nameEn}</span><span class="fa">{nameFa || nameEn}</span></span>
  )}
</Tag>

<style>
  .av {
    --bg: var(--c1);
    --bg2: var(--c2);
    display: inline-grid;
    place-items: center;
    width: var(--sz);
    height: var(--sz);
    flex: none;
    text-decoration: none;
    position: relative;
  }
  .av__disc {
    width: 100%; height: 100%;
    border-radius: 50%;
    display: grid; place-items: center;
    background: linear-gradient(145deg, var(--bg) 0%, var(--bg2) 100%);
    color: #fff;
    font-family: var(--fs-ui);
    font-weight: 650;
    letter-spacing: .01em;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.22), inset 0 -1px 0 rgba(0,0,0,.18);
    overflow: hidden;
  }
  .av__disc--ring { outline: 2px solid var(--paper-2); outline-offset: -1px; }
  .av__mono { font-size: calc(var(--sz) * 0.38); line-height: 1; transform: translateY(1px); }
  /* Portraits of this period are nearly all head-and-shoulders plates, so the
     face sits above centre; pulling the crop up keeps it in the circle. */
  .av__img { width: 100%; height: 100%; object-fit: cover; object-position: center 26%;
             display: block; }
  .av__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
