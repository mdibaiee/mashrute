---
import Avatar from './Avatar.astro';

// Overlapping discs, which fan out on hover and open into a wrapped list of
// named chips when the card is active. Every person is rendered; the ones past
// `max` are hidden until then, so opening the card reveals the whole cast
// rather than a "+9" that cannot be tapped.
const { people = [], size = 34, max = 7 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const extra = people.length - max;
---
{people.length > 0 && (
  <div class="stack" style={`--sz:${size}px`}
       aria-label={`${people.length} people involved`}>
    {people.map((p, i) => (
      <a class:list={['stack__item', { 'stack__item--extra': i >= max }]}
         style={`--i:${Math.min(i, max)}`}
         href={`${base}/people/${p.person_id}/`}>
        <Avatar id={p.person_id} nameEn={p.name_en} nameFa={p.name_fa}
                size={size} link={false} />
        <span class="stack__tip">
          <b><span class="en">{p.name_en}</span><span class="fa">{p.name_fa || p.name_en}</span></b>
          {(p.role_en || p.role_fa) && (
            <i><span class="en">{p.role_en}</span><span class="fa">{p.role_fa || p.role_en}</span></i>
          )}
        </span>
      </a>
    ))}
    {extra > 0 && (
      <span class="stack__item stack__more" style={`--i:${max}`} aria-hidden="true">
        <span class="stack__disc">+{extra}</span>
      </span>
    )}
  </div>
)}

<style is:global>
  .stack {
    display: flex;
    align-items: center;
    padding: 2px 0;
    width: max-content;
    max-width: 100%;
    outline: none;
  }
  .stack__item {
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    /* Overlap by 40% of the disc; the first one keeps its place. */
    margin-inline-start: calc(var(--i) * 0px - (var(--sz) * 0.4));
    transition: margin .28s cubic-bezier(.2,.9,.3,1), transform .2s ease;
    z-index: 1;
  }
  .stack__item:first-child { margin-inline-start: 0; }
  /* Hidden until the card opens, so a collapsed stack stays a stack. */
  .stack__item--extra { display: none; }
  .stack:hover .stack__item,
  .stack:focus-within .stack__item { margin-inline-start: 3px; }
  .stack:hover .stack__item:first-child,
  .stack:focus-within .stack__item:first-child { margin-inline-start: 0; }
  .stack__item:hover, .stack__item:focus-within { z-index: 6; transform: translateY(-2px); }

  .stack__disc {
    width: var(--sz); height: var(--sz); border-radius: 50%;
    display: grid; place-items: center;
    background: var(--line-2); color: var(--ink-2);
    font-family: var(--fs-ui); font-size: calc(var(--sz) * .34); font-weight: 650;
    outline: 2px solid var(--paper-2); outline-offset: -1px;
  }

  .stack__tip {
    position: absolute;
    bottom: calc(100% + 9px);
    inset-inline-start: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--ink);
    color: var(--paper-2);
    padding: .42rem .6rem;
    border-radius: 8px;
    font-family: var(--fs-ui);
    font-size: .74rem;
    line-height: 1.35;
    width: max-content;
    max-width: min(15rem, calc(100vw - 2rem));
    white-space: normal;
    text-align: start;
    opacity: 0; pointer-events: none;
    transition: opacity .16s ease, transform .16s ease;
    z-index: 30;
    box-shadow: 0 6px 18px rgba(0,0,0,.22);
  }
  html[dir='rtl'] .stack__tip { transform: translateX(50%) translateY(4px); }
  .stack__tip b { display: block; font-weight: 650; white-space: nowrap; }
  .stack__tip i { display: block; font-style: normal; opacity: .75; margin-top: 2px; }
  .stack__item:hover .stack__tip,
  .stack__item:focus-within .stack__tip { opacity: 1; transform: translateX(-50%) translateY(0); }
  html[dir='rtl'] .stack__item:hover .stack__tip,
  html[dir='rtl'] .stack__item:focus-within .stack__tip { transform: translateX(50%) translateY(0); }

  /* ---- open state -------------------------------------------------------
     The discs stop overlapping and each carries its name, so on a touch screen
     there is something big enough to hit and something to read before hitting
     it. The role is dropped here: it is too long to sit on one line. */
  .tl-card.is-active .stack,
  .tl-card:focus-within .stack {
    flex-wrap: wrap;
    gap: .3rem;
    width: auto;
  }
  .tl-card.is-active .stack__item,
  .tl-card:focus-within .stack__item {
    margin-inline-start: 0;
    background: var(--paper);
    border: 1px solid var(--line-2);
    border-radius: 99px;
    /* The disc is nearly as tall as the chip, so without this inset the pill's
       curve traces the same arc as the photo and looks like it cuts into it. */
    padding: 2px;
    padding-inline-end: .5rem;
    transform: none;
  }
  .tl-card.is-active .stack__item--extra,
  .tl-card:focus-within .stack__item--extra { display: inline-flex; }
  .tl-card.is-active .stack__more,
  .tl-card:focus-within .stack__more { display: none; }
  .tl-card.is-active .stack__tip,
  .tl-card:focus-within .stack__tip {
    position: static;
    transform: none;
    opacity: 1;
    pointer-events: auto;
    background: transparent;
    color: var(--ink-2);
    box-shadow: none;
    padding: 0 .4rem;
    max-width: 10rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tl-card.is-active .stack__tip i,
  .tl-card:focus-within .stack__tip i { display: none; }
  .tl-card.is-active .stack__item:hover,
  .tl-card:focus-within .stack__item:hover { border-color: var(--lapis); }

  @media (prefers-reduced-motion: reduce) {
    .stack__item, .stack__tip { transition: none; }
  }
</style>
