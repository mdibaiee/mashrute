---
// Shares the page's title, link and — for an event — its description.
//
// navigator.share opens the platform's own share sheet, which is where this
// belongs on a phone. Desktop browsers mostly lack it, so there the link is
// copied to the clipboard instead and the button says so.
const {
  url = '',        // path to share; resolved against the current origin
  title = '',      // English title
  titleFa = '',
  text = '',       // English description, events only
  textFa = '',
  kicker = '',     // date, life span, or type — the line above the title
  kickerFa = '',
  meta = '',       // place, shown small under the body
  metaFa = '',
  compact = false,
} = Astro.props;
---
<button
  type="button"
  class:list={['share', { 'share--compact': compact }]}
  data-share
  data-url={url}
  data-title={title}
  data-title-fa={titleFa}
  data-text={text}
  data-text-fa={textFa}
  data-kicker={kicker}
  data-kicker-fa={kickerFa}
  data-meta={meta}
  data-meta-fa={metaFa}
  aria-label="Share · هم‌رسانی"
>
  <svg viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="15" cy="4.5" r="2.2" /><circle cx="5" cy="10" r="2.2" /><circle cx="15" cy="15.5" r="2.2" />
    <path d="M12.9 5.6 7.1 8.9M7.1 11.1l5.8 3.3" />
  </svg>
  <span class="share__t"><span class="en">Share</span><span class="fa">هم‌رسانی</span></span>
  <span class="share__done"><span class="en">Link copied</span><span class="fa">نشانی کپی شد</span></span>
</button>

<script>
  import { renderStory } from '../lib/story.js';

  // Whether this browser will take a file in the share sheet at all. Probing
  // needs an actual File, so a one-byte stand-in answers it once.
  const FILES_OK = (() => {
    try {
      const probe = new File([new Uint8Array(1)], 'p.png', { type: 'image/png' });
      return !!(navigator.canShare && navigator.share && navigator.canShare({ files: [probe] }));
    } catch { return false; }
  })();

  // Faces come from the card already on screen rather than from more markup on
  // every one of two hundred cards.
  function facesIn(scope: Element | Document) {
    const nodes = scope.querySelectorAll('.stack__item:not(.stack__more) .av, .mem .av');
    const all = [...nodes];
    const faces = all.slice(0, 6).map((av) => {
      const img = av.querySelector('img.av__img') as HTMLImageElement | null;
      if (img) return { src: img.currentSrc || img.src };
      const cs = getComputedStyle(av as Element);
      const mono = av.querySelector('.av__mono');
      const shown = mono
        ? [...mono.children].find((c) => getComputedStyle(c).display !== 'none')
        : null;
      return {
        c1: cs.getPropertyValue('--c1').trim(),
        c2: cs.getPropertyValue('--c2').trim(),
        mono: (shown ? shown.textContent : mono?.textContent || '').trim(),
      };
    });
    return { faces, extra: Math.max(0, all.length - faces.length) };
  }

  function storyFor(btn: HTMLElement) {
    const fa = document.documentElement.getAttribute('data-lang') === 'fa';
    const d = btn.dataset;
    const pick = (en?: string, faV?: string) => ((fa ? faV : en) || en || '').trim();
    const scope = btn.closest('.tl-card') || document;
    const { faces, extra } = facesIn(scope);
    return {
      fa,
      kicker: pick(d.kicker, d.kickerFa),
      title: pick(d.title, d.titleFa) || document.title,
      body: pick(d.text, d.textFa),
      meta: pick(d.meta, d.metaFa),
      faces, extra,
      brand: fa ? 'مشروطه' : 'Mashruteh',
      url: location.host,
    };
  }

  // Rendering takes a moment, so it starts on the press and is awaited on the
  // release — by then it is usually done, and the share sheet opens promptly.
  const warmed = new WeakMap<HTMLElement, Promise<Blob | null>>();
  function warm(btn: HTMLElement) {
    if (!FILES_OK || warmed.has(btn)) return warmed.get(btn);
    const job = renderStory(storyFor(btn)).catch(() => null);
    warmed.set(btn, job);
    return job;
  }
  document.addEventListener('pointerdown', (ev) => {
    const btn = (ev.target as HTMLElement).closest('[data-share]') as HTMLElement | null;
    if (btn) warm(btn);
  }, { passive: true });

  // One delegated listener for every button on the page — the chronology has
  // over two hundred of them.
  document.addEventListener('click', async (ev) => {
    const btn = (ev.target as HTMLElement).closest('[data-share]') as HTMLElement | null;
    if (!btn) return;

    const fa = document.documentElement.getAttribute('data-lang') === 'fa';
    const d = btn.dataset;
    const title = (fa ? d.titleFa : d.title) || d.title || document.title;
    const desc = (fa ? d.textFa : d.text) || d.text || '';
    const url = new URL(d.url || location.href, location.href).href;
    const body = desc ? `${title}\n\n${desc}` : title;

    if (navigator.share) {
      // With a picture in the payload the sheet offers the image apps —
      // Instagram among them, where it can be posted as a story. The page
      // cannot name that target itself; it can only hand over a real file.
      let file: File | null = null;
      if (FILES_OK) {
        const blob = await (warm(btn) || Promise.resolve(null));
        warmed.delete(btn);
        if (blob) {
          const name = (d.url || 'mashrute').split('/').filter(Boolean).pop() || 'mashrute';
          file = new File([blob], `${name}.png`, { type: 'image/png' });
        }
      }

      const payloads = file
        ? [{ files: [file], text: body, url }, { files: [file] }, { title, text: body, url }]
        : [{ title, text: body, url }];
      for (const payload of payloads) {
        if (navigator.canShare && !navigator.canShare(payload)) continue;
        try {
          await navigator.share(payload);
          return;
        } catch (err) {
          // Cancelling the sheet rejects; that is not a failure to report.
          if ((err as Error).name === 'AbortError') return;
        }
      }
    }

    try {
      await navigator.clipboard.writeText(`${body}\n${url}`);
      btn.classList.add('is-copied');
      setTimeout(() => btn.classList.remove('is-copied'), 2200);
    } catch {
      // Clipboard blocked (insecure context, or permission denied): fall back
      // to selecting the text so it can at least be copied by hand.
      window.prompt('Copy this link · این نشانی را کپی کنید', url);
    }
  });
</script>

<style is:global>
  .share {
    display: inline-flex; align-items: center; gap: .4rem;
    font-family: var(--fs-ui); font-size: .78rem; font-weight: 500;
    color: var(--ink-3); background: transparent;
    border: 1px solid var(--line); border-radius: 99px;
    padding: .3rem .7rem; cursor: pointer;
    transition: color .15s, border-color .15s, background .15s;
  }
  .share:hover, .share:focus-visible {
    color: var(--lapis); border-color: var(--lapis);
    background: color-mix(in srgb, var(--turquoise) 10%, transparent);
  }
  .share svg {
    width: 14px; height: 14px; flex: none;
    fill: none; stroke: currentColor; stroke-width: 1.6;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .share__done { display: none; }
  .share.is-copied { color: var(--green); border-color: var(--green); }
  .share.is-copied .share__t { display: none; }
  .share.is-copied .share__done { display: inline; }

  /* On a timeline card the label would compete with the event title. */
  .share--compact { border-color: transparent; padding: .25rem .4rem; }
  .share--compact .share__t, .share--compact .share__done {
    max-width: 0; overflow: hidden; white-space: nowrap; opacity: 0;
    transition: max-width .2s ease, opacity .2s ease;
  }
  .tl-card:hover .share--compact .share__t,
  .tl-card.is-active .share--compact .share__t,
  .tl-card:focus-within .share--compact .share__t,
  .share--compact:focus-visible .share__t,
  .share--compact.is-copied .share__done {
    max-width: 12rem; opacity: 1;
  }
  .share--compact.is-copied .share__t { max-width: 0; opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .share, .share--compact .share__t, .share--compact .share__done { transition: none; }
  }
</style>
