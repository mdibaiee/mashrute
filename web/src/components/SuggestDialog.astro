---
import { SUGGEST_ENDPOINT } from '../lib/site.js';
const fa = (Astro.currentLocale ?? 'fa') === 'fa';
---
{SUGGEST_ENDPOINT && (
<dialog id="sgDlg" class="sg" aria-labelledby="sgTitle" data-endpoint={SUGGEST_ENDPOINT}>
  <div class="sg__box">
    <h2 id="sgTitle">
      {fa ? "پیشنهاد بروزرسانی" : "Suggest a change"}
    </h2>
    <p class="sg__about" id="sgAbout"></p>

    <div id="sgFields">
      <label class="sg__label" for="sgText">
        {fa ? "چه چیزی باید اصلاح یا افزوده شود؟" : "What should be corrected or added?"}
      </label>
      <textarea id="sgText" rows="7"
        placeholder={fa
          ? 'اصلاح مورد نظر را بنویسید. اگر منبعی می‌شناسید ذکر کنید؛ راستی‌آزمایی را بسیار آسان‌تر می‌کند.'
          : 'Describe the correction. If you can name a source, please do — it makes the change far easier to verify.'}></textarea>

      <!-- Hidden from people; anything typed here came from a bot. -->
      <div class="sg__hp" aria-hidden="true">
        <label for="sgHp">Leave this field empty</label>
        <input id="sgHp" type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <p class="sg__note">
        {fa ? "به‌صورت ناشناس فرستاده می‌شود — نام، ایمیل یا حساب کاربری لازم نیست." : "Sent anonymously — no name, email or account needed."}
      </p>
    </div>

    <p class="sg__msg" id="sgMsg" hidden></p>

    <div class="sg__actions">
      <button type="button" id="sgClose" class="sg__btn sg__btn--ghost">
        {fa ? "انصراف" : "Cancel"}
      </button>
      <button type="button" id="sgSend" class="sg__btn sg__btn--go">
        {fa ? "فرستادن پیشنهاد" : "Send suggestion"}
      </button>
    </div>
  </div>
</dialog>
)}

<script>
  const dlg = document.getElementById('sgDlg');
  if (dlg) {
    const text = document.getElementById('sgText');
    const hp = document.getElementById('sgHp');
    const about = document.getElementById('sgAbout');
    const msg = document.getElementById('sgMsg');
    const send = document.getElementById('sgSend');
    const fields = document.getElementById('sgFields');
    const endpoint = dlg.dataset.endpoint;
    let current = {};

    const isFa = () => document.documentElement.getAttribute('data-lang') === 'fa';

    const SAYS = {
      short: ['Please write a little more first.', 'لطفاً کمی بیشتر توضیح دهید.'],
      rate: ['A few suggestions have already been sent from here. Please try again later.',
             'چند پیشنهاد از این نشانی فرستاده شده است. لطفاً بعداً دوباره تلاش کنید.'],
      failed: ['That could not be sent. Please try again later.',
               'فرستادن انجام نشد. لطفاً بعداً دوباره تلاش کنید.'],
      sent: ['Thank you — your suggestion was received.',
             'سپاسگزارم — پیشنهاد شما دریافت شد.'],
      sending: ['Sending…', 'در حال فرستادن…'],
    };
    const say = (k) => (isFa() ? SAYS[k][1] : SAYS[k][0]);


    function show(kind, key) {
      msg.hidden = false;
      msg.className = 'sg__msg sg__msg--' + kind;
      msg.textContent = say(key);
    }

    document.addEventListener('click', (ev) => {
      const btn = ev.target.closest('[data-suggest]');
      if (!btn) return;
      current = { ...btn.dataset };
      about.textContent = (isFa() ? 'درباره: ' : 'About: ')
        + (current.label || document.title);
      text.value = '';
      hp.value = '';
      msg.hidden = true;
      fields.hidden = false;
      send.hidden = false;
      send.disabled = false;
      dlg.showModal();
      text.focus();
    });

    document.getElementById('sgClose').addEventListener('click', () => dlg.close());
    // Clicking the backdrop closes it, matching Cancel.
    dlg.addEventListener('click', (ev) => { if (ev.target === dlg) dlg.close(); });

    send.addEventListener('click', async () => {
      const body = text.value.trim();
      if (body.length < 20) { show('warn', 'short'); text.focus(); return; }

      send.disabled = true;
      show('info', 'sending');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            text: body,
            hp: hp.value,
            kind: current.kind || 'page',
            id: current.id || '',
            // The reader sees their own language; the issue is titled in
            // English so the maintainer's list stays sorted predictably.
            label: current.enLabel || current.label || document.title,
            labelFa: isFa() ? (current.label || '') : '',
            page: location.href,
            lang: isFa() ? 'fa' : 'en',
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          // Hide the form so the thank-you is the only thing left to read.
          fields.hidden = true;
          send.hidden = true;
          show('ok', 'sent');
        } else {
          show('warn', res.status === 429 ? 'rate' : 'failed');
          send.disabled = false;
        }
      } catch {
        show('warn', 'failed');
        send.disabled = false;
      }
    });
  }
</script>

<style is:global>
  .sg::backdrop { background: color-mix(in srgb, var(--ink) 45%, transparent); }
  .sg {
    border: 1px solid var(--line); border-radius: 14px; padding: 0;
    background: var(--paper); color: var(--ink);
    width: min(34rem, calc(100vw - 2rem)); max-height: 90vh;
    box-shadow: 0 18px 50px rgba(20, 24, 58, .22);
  }
  .sg__box { padding: 1.3rem 1.4rem 1.1rem; }
  .sg h2 { margin: 0 0 .3rem; font-size: 1.15rem; }
  .sg__about { margin: 0 0 1rem; font-family: var(--fs-ui); font-size: .78rem;
    color: var(--ink-3); overflow-wrap: anywhere; }
  .sg__label { display: block; font-family: var(--fs-ui); font-size: .82rem;
    font-weight: 600; margin-bottom: .4rem; }
  .sg textarea {
    width: 100%; font: inherit; font-size: .92rem; line-height: 1.7;
    padding: .7rem .8rem; border: 1px solid var(--line); border-radius: 10px;
    background: var(--paper-2); color: var(--ink); resize: vertical;
  }
  .sg textarea:focus { outline: none; border-color: var(--lapis);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--lapis) 16%, transparent); }
  /* Off-screen rather than display:none, which some bots detect. */
  .sg__hp { position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap; }
  .sg__note { font-family: var(--fs-ui); font-size: .74rem; color: var(--ink-3);
    margin: .7rem 0 0; }
  .sg__msg { font-family: var(--fs-ui); font-size: .82rem; margin: .9rem 0 0;
    padding: .55rem .7rem; border-radius: 8px; }
  .sg__msg--ok { color: #0d7d57;
    background: color-mix(in srgb, var(--green) 14%, transparent); }
  .sg__msg--warn { color: #a33463;
    background: color-mix(in srgb, var(--rose) 14%, transparent); }
  .sg__msg--info { color: var(--ink-3); background: var(--line-2); }
  .sg__actions { display: flex; gap: .6rem; justify-content: flex-end;
    margin-top: 1.1rem; flex-wrap: wrap; }
  .sg__btn { font-family: var(--fs-ui); font-size: .85rem; font-weight: 600;
    padding: .5rem 1rem; border-radius: 99px; cursor: pointer;
    border: 1px solid transparent; }
  .sg__btn--ghost { background: transparent; border-color: var(--line); color: var(--ink-2); }
  .sg__btn--ghost:hover { border-color: var(--ink-3); }
  .sg__btn--go { background: var(--lapis); color: #fff; }
  .sg__btn--go:hover { background: var(--accent-2); }
  .sg__btn:disabled { opacity: .55; cursor: default; }
</style>
