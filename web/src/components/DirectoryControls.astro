---
// Search box + list/gallery switch + facet select. Operates on already-rendered
// cards via data- attributes, so it needs no framework and works on 400 rows.
import { faDigits } from '../lib/util.js';
const fa = (Astro.currentLocale ?? 'fa') === 'fa';

const { facets = [], facetLabelEn = 'Type', facetLabelFa = 'دسته', placeholderEn, placeholderFa } = Astro.props;
---
<div class="dir-controls">
  <div class="dir-search">
    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" /><path d="M13.5 13.5 18 18" /></svg>
    <input id="dirSearch" type="search" autocomplete="off" spellcheck="false"
           placeholder={fa ? placeholderFa : placeholderEn} />
  </div>

  {facets.length > 0 && (
    <label class="dir-facet">
      {fa ? facetLabelFa : facetLabelEn}
      <select id="dirFacet">
        <option value="">—</option>
        {facets.map((f) => (
          <option value={f.value}>
            {fa ? `${f.labelFa || f.labelEn} (${faDigits(f.count)})`
                : `${f.labelEn} (${f.count})`}
          </option>
        ))}
      </select>
    </label>
  )}

  <div class="dir-view" role="group" aria-label="View mode">
    <button type="button" data-view="gallery" class="on" aria-pressed="true" title="Gallery">
      <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2" y="2" width="7" height="7" rx="1.5"/><rect x="11" y="2" width="7" height="7" rx="1.5"/><rect x="2" y="11" width="7" height="7" rx="1.5"/><rect x="11" y="11" width="7" height="7" rx="1.5"/></svg>
    </button>
    <button type="button" data-view="list" aria-pressed="false" title="List">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"/></svg>
    </button>
  </div>

  <output id="dirCount" class="dir-count"></output>
</div>

<script is:inline>
  // The language is fixed by the URL, so it is read once.
  var FA = document.documentElement.getAttribute('data-lang') === 'fa';

  function initDirectory() {
    var box = document.getElementById('dirSearch');
    var facet = document.getElementById('dirFacet');
    var grid = document.getElementById('dirGrid');
    var count = document.getElementById('dirCount');
    var empty = document.getElementById('dirEmpty');
    if (!grid) return;
    var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-search]'));

    function norm(s) {
      return (s || '')
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[ً-ٰٟ]/g, '')   // Arabic diacritics
        .replace(/[‌‏‎]/g, ' ')   // ZWNJ / bidi marks
        .replace(/[يى]/g, 'ی').replace(/ك/g, 'ک')
        .replace(/[''‘’`]/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function apply() {
      var q = norm(box.value);
      var f = facet ? facet.value : '';
      var n = 0;
      for (var i = 0; i < cards.length; i++) {
        var c = cards[i];
        var okQ = !q || norm(c.dataset.search).indexOf(q) !== -1;
        var okF = !f || c.dataset.facet === f;
        var show = okQ && okF;
        c.hidden = !show;
        if (show) n++;
      }
      count.textContent = FA
        ? String(n).replace(/[0-9]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'[+d]; }) + ' نتیجه'
        : n + (n === 1 ? ' result' : ' results');
      if (empty) empty.hidden = n > 0;
    }

    box.addEventListener('input', apply);
    facet && facet.addEventListener('change', apply);

    var saved = localStorage.getItem('mashruteh-view') || 'gallery';
    function setView(v) {
      grid.dataset.view = v;
      localStorage.setItem('mashruteh-view', v);
      document.querySelectorAll('.dir-view button').forEach(function (b) {
        var on = b.dataset.view === v;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }
    setView(saved);
    document.querySelectorAll('.dir-view button').forEach(function (b) {
      b.addEventListener('click', function () { setView(b.dataset.view); });
    });

    apply();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDirectory);
  } else {
    initDirectory();
  }
</script>

<style is:global>
  /* Layout for the grid these controls drive. Lives here rather than in either
     directory page, so both get the same list/gallery behaviour. */
  .dir { margin-top: 1.6rem; }
  .dir[data-view='gallery'] {
    display: grid; gap: .9rem;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
  }
  .dir[data-view='list'] { display: flex; flex-direction: column; gap: 0; }
  .dir-empty { color: var(--ink-3); font-family: var(--fs-ui); padding: 2rem 0; }

  .dir-controls { display: flex; gap: .75rem; align-items: center; flex-wrap: wrap; margin: 1.2rem 0 0; }
  .dir-search { position: relative; flex: 1 1 18rem; display: flex; align-items: center; }
  .dir-search svg { position: absolute; inset-inline-start: .7rem; width: 17px; height: 17px;
    fill: none; stroke: var(--ink-3); stroke-width: 1.7; stroke-linecap: round; pointer-events: none; }
  .dir-search input {
    width: 100%; font: inherit; font-size: .92rem; padding: .55rem .8rem .55rem 2.3rem;
    border: 1px solid var(--line); border-radius: 99px; background: var(--paper-2); color: var(--ink);
  }
  html[dir='rtl'] .dir-search input { padding: .55rem 2.3rem .55rem .8rem; }
  .dir-search input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent); }
  .dir-facet { font-family: var(--fs-ui); font-size: .8rem; color: var(--ink-3); display: flex; gap: .45rem; align-items: center; }
  .dir-facet select { font: inherit; padding: .35rem .5rem; border-radius: 8px; border: 1px solid var(--line); background: var(--paper-2); color: var(--ink); max-width: 13rem; }
  .dir-view { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .dir-view button { border: 0; background: var(--paper-2); padding: .4rem .55rem; cursor: pointer; display: grid; place-items: center; }
  .dir-view button + button { border-inline-start: 1px solid var(--line); }
  .dir-view svg { width: 16px; height: 16px; fill: none; stroke: var(--ink-3); stroke-width: 1.7; stroke-linecap: round; }
  .dir-view button.on { background: var(--accent); }
  .dir-view button.on svg { stroke: #fff; }
  .dir-view button.on rect { fill: #fff; stroke: #fff; }
  .dir-count { font-family: var(--fs-ui); font-size: .78rem; color: var(--ink-3); margin-inline-start: auto; }
</style>
