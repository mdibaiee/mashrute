---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import DirectoryControls from '../../components/DirectoryControls.astro';
import people from '../../data/people.json';
import links from '../../data/links.json';
import { faDigits } from '../../lib/util.js';
const fa = (Astro.currentLocale ?? 'fa') === 'fa';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = fa ? base : `${base}/en`;
const actors = people.filter((p) => p.is_historical_actor);
const scholars = people.filter((p) => !p.is_historical_actor);

const facetOf = (p) => {
  if (p.is_foreign) return 'foreign';
  if (p.gender === 'female') return 'women';
  return 'iranian';
};
const facets = [
  { value: 'iranian', labelEn: 'Iranian participants', labelFa: 'مشارکت‌کنندگان ایرانی', count: actors.filter((p) => facetOf(p) === 'iranian').length },
  { value: 'women', labelEn: 'Women', labelFa: 'زنان', count: actors.filter((p) => facetOf(p) === 'women').length },
  { value: 'foreign', labelEn: 'Foreign figures', labelFa: 'چهره‌های خارجی', count: actors.filter((p) => facetOf(p) === 'foreign').length },
];

const enrich = (p) => {
  const ev = links.personEvents[p.id] || [];
  const gr = links.personGroups[p.id] || [];
  const life = [p.birth_g_year, p.death_g_year];
  const lifeStr = life[0] || life[1] ? `${life[0] ?? '?'}–${life[1] ?? '?'}` : '';
  const search = [p.name_en, p.name_fa, p.full_name_en, p.full_name_fa, p.title_en,
                  p.title_fa, p.role_en, p.role_fa, p.nationality_en,
                  ...gr.map((g) => g.group_en), ...gr.map((g) => g.group_fa)]
                 .filter(Boolean).join(' ');
  return { ...p, nEvents: ev.length, nGroups: gr.length, lifeStr, search, topGroups: gr.slice(0, 2) };
};
const rows = actors.map(enrich).sort((a, b) =>
  (b.nEvents + b.nGroups) - (a.nEvents + a.nGroups) || a.name_en.localeCompare(b.name_en));
---
<Base title="People" titleFa="اشخاص" wide
      description="Directory of the people of the Iranian Constitutional Revolution: deputies, clerics, fighters, journalists, teachers and diplomats, with their dates, groups and events."
      descriptionFa="فهرست اشخاص انقلاب مشروطهٔ ایران: نمایندگان، روحانیان، مجاهدان، روزنامه‌نگاران، معلمان و دیپلمات‌ها، همراه با تاریخ‌ها، گروه‌ها و رویدادهایشان."
>
  <Fragment slot="title">
    {fa ? "اشخاص" : "People"}
  </Fragment>
  <Fragment slot="subtitle">
    {fa ? `${faDigits(actors.length)} تن که در انقلاب نقش داشتند — نمایندگان، روحانیان، مجاهدان، روزنامه‌نگاران، معلمان و دیپلمات‌ها. ${faDigits(scholars.length)} پژوهشگر معاصر که آفاری به آنان ارجاع داده، جداگانه در پایین صفحه آمده‌اند.` : `${actors.length} people who acted in the revolution — deputies, clerics, fighters, journalists, teachers, diplomats. ${scholars.length} modern scholars Afary cites are listed separately at the foot of the page.`}
  </Fragment>

  <DirectoryControls
    slot="head-extra"
    facets={facets}
    facetLabelEn="Show" facetLabelFa="نمایش"
    placeholderEn="Search names, roles, groups…"
    placeholderFa="جست‌وجوی نام، نقش، گروه…"
  />

  <div id="dirGrid" class="dir" data-view="gallery">
    {rows.map((p) => (
      <a class="pcard" href={`${L}/people/${p.id}/`} data-search={p.search} data-facet={p.is_foreign ? 'foreign' : (p.gender === 'female' ? 'women' : 'iranian')}>
        <Avatar id={p.id} nameEn={p.name_en} nameFa={p.name_fa} size={56} link={false} />
        <div class="pcard__body">
          <h3>
            {fa ? p.name_fa || p.name_en : p.name_en}
          </h3>
          {p.lifeStr && (
            <span class="pcard__life" dir="ltr">
              {fa ? faDigits(p.lifeStr) : p.lifeStr}
            </span>
          )}
          <p class="pcard__role">
            {fa ? p.role_fa || p.title_fa || p.role_en || '' : p.role_en || p.title_en || ''}
          </p>
          <p class="pcard__stats">
            {p.nEvents > 0 && (
              <span>
                {fa ? "{faDigits(p.nEvents)} رویداد" : p.nEvents} {p.nEvents === 1 ? 'event' : 'events'}
              </span>
            )}
            {p.nEvents > 0 && p.nGroups > 0 && <span class="sep">·</span>}
            {p.nGroups > 0 && (
              <span>
                {fa ? "{faDigits(p.nGroups)} گروه" : p.nGroups} {p.nGroups === 1 ? 'group' : 'groups'}
              </span>
            )}
          </p>
        </div>
      </a>
    ))}
  </div>

  <p id="dirEmpty" class="dir-empty" hidden>
    {fa ? "کسی با این جست‌وجو یافت نشد." : "Nobody matches that search."}
  </p>

  <details class="scholars">
    <summary>
      {fa ? `${faDigits(scholars.length)} مورخ و نظریه‌پرداز معاصر که آفاری به آنان استناد کرده است` : `${scholars.length} modern historians and theorists cited by Afary`}
    </summary>
    <ul>
      {scholars.sort((a, b) => a.name_en.localeCompare(b.name_en)).map((s) => (
        <li>
          <a href={`${L}/people/${s.id}/`}>
            {fa ? s.name_fa || s.name_en : s.name_en}
          </a>
          {s.role_en && <span class="muted"> — {fa ? s.role_fa || s.role_en : s.role_en}</span>}
        </li>
      ))}
    </ul>
  </details>

  <style is:global>
    .pcard {
      display: flex; gap: .85rem; align-items: center; text-decoration: none;
      background: var(--paper-2); border: 1px solid var(--line-2); border-radius: var(--radius);
      padding: .85rem .9rem; transition: border-color .16s ease, transform .16s ease, box-shadow .16s ease;
    }
    .pcard:hover { border-color: var(--line); transform: translateY(-1px); box-shadow: var(--shadow); }
    .dir[data-view='list'] .pcard {
      border-radius: 0; border-inline: 0; border-top: 0; padding: .6rem .3rem; background: transparent;
    }
    .dir[data-view='list'] .pcard:first-child { border-top: 1px solid var(--line-2); }
    .dir[data-view='list'] .pcard:hover { transform: none; box-shadow: none; background: var(--paper-2); }
    .dir[data-view='list'] .pcard .av { --sz: 34px !important; width: 34px; height: 34px; }
    .dir[data-view='list'] .pcard__body { display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
    .dir[data-view='list'] .pcard__role { flex: 1 1 12rem; }

    .pcard__body { min-width: 0; }
    .pcard h3 { margin: 0; font-size: .98rem; line-height: 1.25; }
    .pcard__life { font-family: var(--fs-ui); font-size: .7rem; color: var(--ink-3); }
    .pcard__role { margin: .15rem 0 0; font-size: .8rem; color: var(--ink-2);
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .pcard__stats { margin: .3rem 0 0; font-family: var(--fs-ui); font-size: .7rem; color: var(--ink-3); }
    .pcard__stats .sep { margin: 0 .3rem; }
    .dir-empty { text-align: center; color: var(--ink-3); padding: 2.5rem 0; }

    .scholars { margin-top: 2.5rem; border-top: 1px solid var(--line-2); padding-top: 1.2rem; }
    .scholars summary { cursor: pointer; font-family: var(--fs-ui); font-size: .85rem; color: var(--ink-2); }
    .scholars ul { columns: 2; column-gap: 2rem; margin: 1rem 0 0; padding-inline-start: 1.1rem; font-size: .86rem; }
    .scholars li { break-inside: avoid; margin-bottom: .3rem; }
    @media (max-width: 640px) { .scholars ul { columns: 1; } }
  </style>
</Base>
