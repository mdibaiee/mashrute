---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import people from '../../data/people.json';
import links from '../../data/links.json';
import events from '../../data/events.json';
import { GROUP_TYPE_LABEL, EVENT_TYPE_LABEL, faDigits } from '../../lib/util.js';
import portraits from '../../data/portraits.json';
import { breadcrumbs } from '../../lib/seo.js';
const fa = (Astro.currentLocale ?? 'fa') === 'fa';

const { person: p } = Astro.props;
const shot = portraits[p.id];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = fa ? base : `${base}/en`;

const evById = Object.fromEntries(events.map((e) => [e.id, e]));
const myEvents = (links.personEvents[p.id] || [])
  .map((r) => ({ ...r, ev: evById[r.event_id] }))
  .filter((r) => r.ev)
  .sort((a, b) => a.ev.date_sort.localeCompare(b.ev.date_sort));
const myGroups = links.personGroups[p.id] || [];
const myRels = links.personRelations[p.id] || [];

const origin = String(Astro.site).replace(/\/$/, '');

// Wikipedia and Wikidata identify the same human, which is the strongest way to
// say who this record is about rather than merely what it is called.
const sameAs = [shot?.page_url, shot?.wikidata_id && `https://www.wikidata.org/wiki/${shot.wikidata_id}`]
  .filter(Boolean);

const ld = [
  {
    '@type': 'Person',
    '@id': `${origin}${L}/people/${p.id}/#person`,
    name: fa ? (p.name_fa || p.name_en) : p.name_en,
    alternateName: (fa ? [p.name_en, p.full_name_en] : [p.name_fa, p.full_name_fa])
      .filter(Boolean),
    url: `${origin}${L}/people/${p.id}/`,
    ...(p.birth_iso ? { birthDate: p.birth_iso } : {}),
    ...(p.death_iso ? { deathDate: p.death_iso } : {}),
    ...((fa ? p.role_fa : p.role_en) ? { description: fa ? p.role_fa : p.role_en } : {}),
    ...((fa ? p.biography_fa : p.biography_en)
      ? { disambiguatingDescription: fa ? p.biography_fa : p.biography_en } : {}),
    ...(shot ? { image: `${origin}${shot.src}` } : {}),
    ...(sameAs.length ? { sameAs } : {}),
    ...(myGroups.length ? { memberOf: myGroups.map((g) => ({
      '@type': 'Organization', name: fa ? (g.group_fa || g.group_en) : g.group_en })) } : {}),
  },
  breadcrumbs(origin, fa ? base : `${base}/en`, [
    { name: fa ? 'اشخاص' : 'People', path: '/people/' },
    { name: fa ? (p.name_fa || p.name_en) : p.name_en, path: `/people/${p.id}/` },
  ]),
];

const RELATION_LABEL = {
  ally: ['Ally', 'هم‌پیمان'], rival: ['Rival', 'رقیب'], kin: ['Kin', 'خویشاوند'],
  assassinated: ['Assassinated', 'ترور کرد'], succeeded: ['Succeeded', 'جانشین'],
  mentor: ['Mentor / student', 'استاد یا شاگرد'], collaborator: ['Collaborator', 'همکار'],
};
const life = [p.birth_display_en, p.death_display_en].filter(Boolean).join(' – ');
const lifeFa = [p.birth_display_fa, p.death_display_fa].filter(Boolean).join(' – ');
---
<Base title={p.name_en} titleFa={p.name_fa}
      description={[life, p.role_en || p.title_en, p.biography_en].filter(Boolean).join(' — ')}
      descriptionFa={[lifeFa, p.role_fa || p.title_fa, p.biography_fa].filter(Boolean).join(' — ')}
      image={shot ? new URL(shot.src, Astro.site).href : ''}
      ogType="profile" jsonld={ld} suggestKind="person" suggestId={p.id} suggestLabel={p.name_en} suggestLabelFa={p.name_fa}
      shareTitle={p.name_en} shareTitleFa={p.name_fa}
      shareKicker={life} shareKickerFa={lifeFa}
      shareText={p.role_en || p.title_en} shareTextFa={p.role_fa || p.title_fa || p.role_en}>
  <div slot="title" class="ph-title">
    <Avatar id={p.id} nameEn={p.name_en} nameFa={p.name_fa} size={72} link={false} />
    <span>
      {fa ? p.name_fa || p.name_en : p.name_en}
      {!p.is_historical_actor && <em class="ph-flag">{fa ? "پژوهشگر مورد استناد" : "cited scholar"}</em>}
    </span>
  </div>
  <p slot="subtitle" class="ph-sub">
    {fa ? p.role_fa || p.title_fa || p.role_en : p.role_en || p.title_en}
  </p>

  <div class="detail">
    <div class="detail__main">
      {(p.biography_en || p.biography_fa) && (
        <p class="lede">
          {fa ? p.biography_fa || p.biography_en : p.biography_en}
        </p>
      )}

      {myEvents.length > 0 && (
        <section>
          <h2>{fa ? "رویدادها" : "Events"} <em>{fa ? faDigits(myEvents.length) : myEvents.length}</em></h2>
          <ol class="tl-mini">
            {myEvents.map((r) => (
              <li>
                <a href={`${L}/events/${r.ev.id}/`}>
                  <time>
                    {fa ? r.ev.date_display_fa || r.ev.date_display_en : r.ev.date_display_en}
                  </time>
                  <b>{fa ? r.ev.title_fa || r.ev.title_en : r.ev.title_en}</b>
                </a>
                {(r.role_en || r.role_fa) && (
                  <span class="tl-mini__role">
                    {fa ? r.role_fa || r.role_en : r.role_en}
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}

      {myRels.length > 0 && (
        <section>
          <h2>{fa ? "پیوندها" : "Connections"}</h2>
          <ul class="rels">
            {myRels.map((r) => {
              const lab = RELATION_LABEL[r.type] || [r.type, r.type];
              return (
                <li>
                  <span class="tag">{fa ? lab[1] : lab[0]}</span>
                  <a href={`${L}/people/${r.person_b}/`}>
                    {fa ? r.b_fa || r.b_en : r.b_en}
                  </a>
                  {(r.note_en || r.note_fa) && (
                    <p class="muted">
                      {fa ? r.note_fa || r.note_en : r.note_en}
                    </p>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </div>

    <aside class="detail__side">
      <dl class="facts">
        {p.full_name_en && p.full_name_en !== p.name_en && (
          <><dt>{fa ? "نام کامل" : "Full name"}</dt>
            <dd>{fa ? p.full_name_fa || p.full_name_en : p.full_name_en}</dd></>
        )}
        {p.title_en && (
          <><dt>{fa ? "عنوان" : "Title"}</dt>
            <dd>{fa ? p.title_fa || p.title_en : p.title_en}</dd></>
        )}
        {life && (
          <><dt>{fa ? "زندگی" : "Life"}</dt>
            <dd>{fa ? lifeFa || life : life}</dd></>
        )}
        {(p.death_cause_en || p.death_cause_fa) && (
          <><dt>{fa ? "مرگ" : "Death"}</dt>
            <dd>{fa ? p.death_cause_fa || p.death_cause_en : p.death_cause_en}</dd></>
        )}
        {p.nationality_en && (
          <><dt>{fa ? "ملیت" : "Nationality"}</dt>
            <dd>{fa ? p.nationality_fa || p.nationality_en : p.nationality_en}</dd></>
        )}
        {shot && (
          <><dt>{fa ? "تصویر" : "Portrait"}</dt>
            <dd class="muted"><a href={shot.page_url} target="_blank" rel="noopener">
              {fa ? "از ویکی‌پدیا" : "via Wikipedia"}</a></dd></>
        )}
        {p.book_pages?.length > 0 && (
          <><dt>{fa ? "در کتاب" : "In the book"}</dt>
            <dd class="muted">
              {fa ? "ص‌ص {faDigits(p.book_pages.join('، '))}" : "pp. {p.book_pages.join(', ')}"}
            </dd></>
        )}
      </dl>

      {myGroups.length > 0 && (
        <div class="sidebox">
          <h3>{fa ? "گروه‌ها" : "Groups"}</h3>
          <ul class="sidelist">
            {myGroups.map((g) => (
              <li>
                <a href={`${L}/groups/${g.group_id}/`}>
                  {fa ? g.group_fa || g.group_en : g.group_en}
                </a>
                {(g.role_en || g.role_fa) && (
                  <em>{fa ? g.role_fa || g.role_en : g.role_en}</em>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>

  <p class="backlink"><a href={`${L}/people/`}>← {fa ? "همهٔ اشخاص" : "All people"}</a></p>

  <style is:global>
    .ph-title { display: flex; align-items: center; gap: 1rem; }
    .ph-flag { display: block; font-size: .68rem; font-style: normal; font-family: var(--fs-ui);
      color: var(--ink-3); letter-spacing: .05em; text-transform: uppercase; margin-top: .2rem; }
    .ph-sub { font-size: 1.02rem; }
    .detail { display: grid; grid-template-columns: 1fr 17rem; gap: 2.5rem; align-items: start; }
    .detail__main section { margin-bottom: 2.2rem; }
    .detail h2 { font-size: 1.05rem; margin: 0 0 .8rem; padding-bottom: .35rem;
      border-bottom: 1px solid var(--line-2); display: flex; gap: .5rem; align-items: baseline; }
    .detail h2 em { font-style: normal; font-family: var(--fs-ui); font-size: .74rem; color: var(--ink-3); }
    .lede { font-size: 1.02rem; color: var(--ink-2); margin: 0 0 2rem; }

    .tl-mini { list-style: none; margin: 0; padding: 0; }
    .tl-mini li { padding: .5rem 0; border-bottom: 1px solid var(--line-2); }
    .tl-mini a { display: flex; gap: .8rem; align-items: baseline; text-decoration: none; }
    .tl-mini time { font-family: var(--fs-ui); font-size: .74rem; color: var(--accent);
      flex: none; width: 9.5rem; font-weight: 600; }
    .tl-mini b { font-weight: 500; }
    .tl-mini a:hover b { text-decoration: underline; text-underline-offset: 3px; }
    .tl-mini__role { display: block; margin-inline-start: 10.3rem; font-size: .82rem; color: var(--ink-3); }

    .rels { list-style: none; margin: 0; padding: 0; }
    .rels li { padding: .55rem 0; border-bottom: 1px solid var(--line-2); }
    .rels a { font-weight: 500; margin-inline-start: .5rem; }
    .rels p { margin: .25rem 0 0; font-size: .84rem; }

    .facts { margin: 0 0 1.6rem; font-size: .86rem; }
    .facts dt { font-family: var(--fs-ui); font-size: .68rem; text-transform: uppercase;
      letter-spacing: .05em; color: var(--ink-3); margin-top: .8rem; }
    .facts dd { margin: .15rem 0 0; }
    .sidebox { border-top: 1px solid var(--line-2); padding-top: 1rem; }
    .sidebox h3 { font-size: .78rem; font-family: var(--fs-ui); text-transform: uppercase;
      letter-spacing: .05em; color: var(--ink-3); margin: 0 0 .6rem; }
    .sidelist { list-style: none; margin: 0; padding: 0; font-size: .88rem; }
    .sidelist li { margin-bottom: .55rem; }
    .sidelist em { display: block; font-style: normal; font-size: .76rem; color: var(--ink-3); }
    .backlink { margin-top: 2rem; font-family: var(--fs-ui); font-size: .85rem; }
    .backlink a { text-decoration: none; color: var(--ink-3); }
    .backlink a:hover { color: var(--accent); }

    @media (max-width: 780px) {
      .detail { grid-template-columns: 1fr; gap: 1.5rem; }
      .tl-mini a { flex-direction: column; gap: .1rem; }
      .tl-mini time { width: auto; }
      .tl-mini__role { margin-inline-start: 0; }
    }
  </style>
</Base>
